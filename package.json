{
  "name": "cascadelens",
  "version": "0.5.1",
  "releaseDate": "2026-08-14T00:00:00.000Z",
  "description": "Python-first systemic-risk analysis for evidence-graded graphs, shocks, and verifiable RiskPacks.",
  "private": true,
  "bin": {
    "cascadelens": "./packages/cli/src/index.ts"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "tsx scripts/build-site.ts",
    "build:offline": "tsx scripts/build-site.ts --offline",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run test:examples && npm run validate:content && npm run validate:evidence && npm run test:docs && npm run build && npm run test:rendered && npm run test:a11y && npm run test:security && npm run test:performance",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:a11y": "node --test tests/accessibility.test.mjs",
    "test:docs": "node --test tests/documentation.test.mjs",
    "test:performance": "tsx scripts/check-performance.ts",
    "test:security": "tsx scripts/check-security.ts && npm audit --audit-level=low",
    "test:examples": "npm run example:sdk && npm run cascadelens -- --version && npm run cascadelens -- validate content/cases/suez-route-restress/scenario.json --graph content/cases/suez-route-restress/graph/snapshot.json && npm run cascadelens -- verify content/cases/suez-route-restress/riskpack",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:evidence": "tsx scripts/validate-evidence.ts",
    "generate:catalog": "tsx scripts/export-catalog.ts",
    "generate:cases": "tsx scripts/build-cases.ts",
    "generate:riskpack-archives": "tsx scripts/package-riskpacks.ts",
    "generate:sbom": "tsx scripts/generate-sbom.ts",
    "release:prepare": "tsx scripts/prepare-release.ts",
    "release:verify": "tsx scripts/verify-release.ts",
    "verify:build-reproducibility": "tsx scripts/verify-build-reproducibility.ts",
    "example:sdk": "tsx examples/typescript/analyze-reference-case.ts",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "cascadelens": "tsx packages/cli/src/index.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "image-size": "file:vendor/image-size",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.13.0",
    "eslint": "10.8.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vinext": "^1.0.0-beta.5",
    "vite": "^8.2.1",
    "wrangler": "^4.122.0"
  },
  "overrides": {
    "image-size": "$image-size"
  },
  "type": "module"
}
