{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascadelens.dev/schemas/model-card-1.0.0.schema.json",
  "title": "CascadeLens Model Card 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelId",
    "version",
    "intendedUse",
    "outOfScope",
    "algorithm",
    "evidencePolicy",
    "validationStatus",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "cascadelens-model-card/1.0.0" },
    "modelId": { "type": "string", "minLength": 1 },
    "version": { "const": "0.2.0" },
    "intendedUse": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "outOfScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "algorithm": { "type": "string", "minLength": 1 },
    "evidencePolicy": { "type": "string", "minLength": 1 },
    "validationStatus": {
      "enum": [
        "software_verified_empirically_unvalidated",
        "historically_scored"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
